<div class="hero">
  <div class="eyebrow">Um capítulo por vez</div>
  <h1>Jornada pelas Escrituras</h1>
  <p class="sub">
    Marque o que você já leu, acompanhe sua sequência e desbloqueie conquistas no caminho pelos 66
    livros e 1.189 capítulos da Bíblia.
  </p>

  <div class="rose-wrap">
    <svg viewBox="0 0 300 300">
      <defs>
        <linearGradient id="goldGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#f2c869" />
          <stop offset="100%" stop-color="#c0654a" />
        </linearGradient>
      </defs>
      <g id="petals" opacity="0.35"></g>
      <circle class="ring-bg" cx="150" cy="150" r="120"></circle>
      <circle class="ring-fg" id="ringFg" cx="150" cy="150" r="120"></circle>
    </svg>
    <div class="rose-center">
      <div class="rose-pct" id="pctText">0%</div>
      <div class="rose-frac" id="fracText">0 / 1189 capítulos</div>
      <div class="rose-level" id="levelText">Nível 1 · Peregrino Iniciante</div>
    </div>
  </div>

  <div class="stat-row">
    <div class="stat"><b id="streakStat">0</b><span>sequência (dias)</span></div>
    <div class="stat"><b id="booksStat">0</b><span>livros concluídos</span></div>
    <div class="stat"><b id="badgesStat">0</b><span>conquistas</span></div>
  </div>
</div>
